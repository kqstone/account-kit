{
  "name": "@kqstone/account-ui-vue",
  "version": "0.4.1",
  "description": "Vue 3 login, register, 2FA, WeChat QR login, profile and avatar components for account-kit",
  "keywords": [
    "account-kit",
    "vue",
    "vue3",
    "login",
    "register",
    "2fa",
    "avatar",
    "auth",
    "fastapi"
  ],
  "license": "MIT",
  "author": "kqstone",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "node ../../scripts/prepare-ui.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kqstone/account-kit.git",
    "directory": "packages/account-ui-vue"
  },
  "peerDependencies": {
    "qrcode": "^1.5.0",
    "vue": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "qrcode": { "optional": true }
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^17.4.4",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "provenance": true,
    "access": "public"
  }
}
