{
  "name": "@kqstone/account-ui-vue",
  "version": "0.1.0",
  "description": "Vue 3 login, register, reset-password forms and tier badge for account-kit",
  "keywords": [
    "account-kit",
    "vue",
    "vue3",
    "login",
    "register",
    "auth",
    "fastapi"
  ],
  "license": "MIT",
  "author": "kqstone",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepare": "node ../../scripts/prepare-ui.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kqstone/account-kit.git",
    "directory": "packages/account-ui-vue"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
