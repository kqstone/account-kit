{
  "name": "@kqstone/account-ui-react",
  "version": "0.2.1",
  "description": "React login, register, 2FA, profile and avatar components for account-kit",
  "keywords": [
    "account-kit",
    "react",
    "login",
    "register",
    "2fa",
    "avatar",
    "auth",
    "fastapi"
  ],
  "license": "MIT",
  "author": "kqstone",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepare": "node ../../scripts/prepare-ui.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kqstone/account-kit.git",
    "directory": "packages/account-ui-react"
  },
  "peerDependencies": {
    "qrcode": "^1.5.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "qrcode": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
